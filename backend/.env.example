# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ghostpaymaster

# ─── Redis (BullMQ queue) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── BNB Chain RPC ────────────────────────────────────────────────────────────
BNB_RPC_URL=https://bsc-dataseed.binance.org/
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
CHAIN_ID=56

# ─── Relayer Wallet ───────────────────────────────────────────────────────────
# HOT wallet used only for submitting transactions — keep minimal BNB balance
RELAYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
RELAYER_ADDRESS=0xYOUR_RELAYER_ADDRESS_HERE

# ─── Smart Contracts ──────────────────────────────────────────────────────────
PAYMASTER_CONTRACT_ADDRESS=0xYOUR_PAYMASTER_CONTRACT_ADDRESS
GHOST_POOL_ADDRESS=0xYOUR_GHOST_POOL_ADDRESS
ENTRYPOINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2781

# ─── Bundler (Pimlico / Alchemy) ──────────────────────────────────────────────
BUNDLER_URL=https://api.pimlico.io/v2/56/rpc
PIMLICO_API_KEY=pim_YOUR_API_KEY_HERE

# ─── ZK Circuit Artifacts ─────────────────────────────────────────────────────
CIRCUIT_WASM_PATH=./src/zk/circuits/merkle_proof.wasm
CIRCUIT_ZKEY_PATH=./src/zk/circuits/merkle_proof_final.zkey
CIRCUIT_VERIFICATION_KEY_PATH=./src/zk/circuits/verification_key.json

# ─── Merkle Tree ──────────────────────────────────────────────────────────────
MERKLE_TREE_HEIGHT=20

# ─── Compliance ───────────────────────────────────────────────────────────────
OFAC_SYNC_INTERVAL_MS=3600000
# Optional: Chainalysis API key for risk scoring
CHAINALYSIS_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
