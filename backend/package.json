{
  "name": "ghost-paymaster-backend",
  "version": "1.0.0",
  "description": "Privacy-Preserving Gas Relayer backend for BNB Chain — Ghost Paymaster",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "tsx src/relayer/queue.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "sync:ofac": "tsx scripts/sync-ofac.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@prisma/client": "^5.14.0",
    "@railgun-community/shared-models": "^8.0.1",
    "@railgun-community/wallet": "^10.8.3",
    "axios": "^1.7.3",
    "bullmq": "^5.12.0",
    "circomlibjs": "^0.1.7",
    "ethers": "^6.13.1",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.1",
    "permissionless": "0.2.35",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "snarkjs": "^0.7.4",
    "viem": "2.21.58",
    "xml2js": "^0.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^2.0.3",
    "eslint": "^9.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "privacy",
    "zk",
    "bnb",
    "paymaster",
    "erc4337"
  ],
  "author": "Ghost Privacy Suite",
  "license": "MIT"
}
