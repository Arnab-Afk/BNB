{
  "name": "@ghost-privacy/contracts",
  "version": "1.0.0",
  "description": "Ghost Privacy Suite — Solidity Smart Contracts",
  "private": true,
  "scripts": {
    "compile": "node node_modules/hardhat/internal/cli/cli.js compile",
    "test": "node node_modules/hardhat/internal/cli/cli.js test",
    "test:gas": "cross-env REPORT_GAS=true node node_modules/hardhat/internal/cli/cli.js test",
    "coverage": "node node_modules/hardhat/internal/cli/cli.js coverage",
    "deploy:local": "node node_modules/hardhat/internal/cli/cli.js run scripts/deploy.ts --network localhost",
    "deploy:testnet": "node node_modules/hardhat/internal/cli/cli.js run scripts/deploy.ts --network bsc-testnet",
    "deploy:mainnet": "node node_modules/hardhat/internal/cli/cli.js run scripts/deploy.ts --network bsc",
    "fund:testnet": "node node_modules/hardhat/internal/cli/cli.js run scripts/fund-paymaster.ts --network bsc-testnet",
    "fund:mainnet": "node node_modules/hardhat/internal/cli/cli.js run scripts/fund-paymaster.ts --network bsc",
    "verify:testnet": "node node_modules/hardhat/internal/cli/cli.js run scripts/verify-contracts.ts --network bsc-testnet",
    "verify:mainnet": "node node_modules/hardhat/internal/cli/cli.js run scripts/verify-contracts.ts --network bsc",
    "node": "node node_modules/hardhat/internal/cli/cli.js node",
    "clean": "node node_modules/hardhat/internal/cli/cli.js clean"
  },
  "dependencies": {
    "@account-abstraction/contracts": "^0.7.0",
    "@openzeppelin/contracts": "^5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.4.1",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "dotenv": "^16.0.0",
    "ethers": "^6.0.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^1.0.10",
    "snarkjs": "^0.7.6",
    "solidity-coverage": "^0.8.0",
    "ts-node": "^10.9.0",
    "typechain": "^8.3.0",
    "typescript": "^5.0.0"
  }
}
