{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "dist",
        "types": [
            "hardhat/types",
            "@nomicfoundation/hardhat-ethers",
            "mocha",
            "chai",
            "node"
        ],
        "typeRoots": [
            "./node_modules/@types",
            "./node_modules"
        ]
    },
    "include": [
        "./scripts",
        "./test"
    ],
    "files": [
        "./hardhat.config.ts"
    ]
}